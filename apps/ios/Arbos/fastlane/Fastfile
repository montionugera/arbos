# Arbos iPhone app — fastlane lanes.
#
# `beta` reproduces the TestFlight path that already shipped build 7 of this
# bundle from unarbos/arbos `.github/workflows/ios.yml`, step for step:
#   1. archive with signing off (CODE_SIGNING_ALLOWED=NO),
#   2. export with method app-store-connect / destination upload / automatic
#      signing, letting Xcode mint the distribution certificate and profile
#      through the App Store Connect API key (-allowProvisioningUpdates).
#
# Secrets come from the environment under the same names as the repo secrets:
#   AC_API_KEY_P8 (key contents) or AC_API_KEY_PATH (file), AC_API_KEY_ID,
#   AC_API_ISSUER_ID, ARBOS_APPLE_TEAM_ID (defaults to the project's team).
# The API key must have "cloud-managed distribution certificate" access
# (App Store Connect → Users and Access → Integrations); a key without it
# fails the export with "Cloud signing permission error".
# Nothing is written into the repo; the key file lives in a temp dir and is
# removed when the lane ends.
#
# Build number: BUILD_NUMBER if set, else UTC `YYYYMMDDHHMM` (12 digits, always
# above the 7 that build 7 used, strictly increasing between runs).

default_platform(:ios)

PROJECT = "Arbos.xcodeproj"
SCHEME = "Arbos"
DEFAULT_TEAM = "25SCF3Q2AK"

def build_number
  ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
end

def out_dir
  dir = ENV["ARBOS_OUT"] || File.expand_path("../build", __dir__)
  FileUtils.mkdir_p(dir)
  dir
end

platform :ios do
  desc "Debug build for the iOS simulator (no signing)"
  lane :sim do
    sh "cd .. && xcodebuild build -project #{PROJECT} -scheme #{SCHEME} -configuration Debug " \
       "-destination 'platform=iOS Simulator,name=iPhone 17' -derivedDataPath '#{out_dir}/dd' " \
       "CODE_SIGNING_ALLOWED=NO | tail -5"
  end

  desc "Unsigned Release archive (what CI keeps even when no Apple secret is set)"
  lane :archive do
    number = build_number
    archive_path = "#{out_dir}/Arbos.xcarchive"
    sh "cd .. && xcodebuild -project #{PROJECT} -scheme #{SCHEME} " \
       "-configuration Release -destination 'generic/platform=iOS' " \
       "-archivePath '#{archive_path}' archive " \
       "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO " \
       "CURRENT_PROJECT_VERSION=#{number} | tail -3"
    UI.user_error!("archive has no binary") unless File.executable?("#{archive_path}/Products/Applications/Arbos.app/Arbos")
    UI.success("Archive #{archive_path} build #{number}")
    lane_context[:ARBOS_ARCHIVE] = archive_path
    lane_context[:ARBOS_BUILD_NUMBER] = number
  end

  desc "Archive, sign through the App Store Connect API key, upload to TestFlight"
  lane :beta do
    key_id = ENV["AC_API_KEY_ID"]
    issuer_id = ENV["AC_API_ISSUER_ID"]
    team_id = ENV["ARBOS_APPLE_TEAM_ID"] || DEFAULT_TEAM
    missing = []
    missing << "AC_API_KEY_ID" if key_id.to_s.empty?
    missing << "AC_API_ISSUER_ID" if issuer_id.to_s.empty?
    missing << "AC_API_KEY_P8 or AC_API_KEY_PATH" if ENV["AC_API_KEY_P8"].to_s.empty? && ENV["AC_API_KEY_PATH"].to_s.empty?
    UI.user_error!("Apple secrets not set: #{missing.join(', ')}") unless missing.empty?

    archive
    archive_path = lane_context[:ARBOS_ARCHIVE]
    number = lane_context[:ARBOS_BUILD_NUMBER]

    tmp = Dir.mktmpdir("arbos-sign")
    begin
      key_path = ENV["AC_API_KEY_PATH"]
      if key_path.to_s.empty?
        key_path = File.join(tmp, "AuthKey_#{key_id}.p8")
        File.write(key_path, ENV["AC_API_KEY_P8"])
        File.chmod(0o600, key_path)
      end
      options = File.join(tmp, "ExportOptions.plist")
      File.write(options, <<~PLIST)
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>method</key><string>app-store-connect</string>
          <key>destination</key><string>upload</string>
          <key>signingStyle</key><string>automatic</string>
          <key>teamID</key><string>#{team_id}</string>
        </dict>
        </plist>
      PLIST
      export_path = "#{out_dir}/TestFlightExport"
      sh "xcodebuild -exportArchive -archivePath '#{archive_path}' -exportPath '#{export_path}' " \
         "-exportOptionsPlist '#{options}' -allowProvisioningUpdates " \
         "-authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' " \
         "-authenticationKeyIssuerID '#{issuer_id}' | tail -20"
      UI.success("Uploaded Arbos build #{number} to TestFlight (bundle com.unarbos.arbos.ios)")
    ensure
      FileUtils.rm_rf(tmp)
    end
  end
end
